{
  "name": "worker-docs",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/previews/*"]
  },
  "routes": [
    {
      "pattern": "docs.solarianetwork.site",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  }
}
